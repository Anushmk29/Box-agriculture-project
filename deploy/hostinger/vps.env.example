# Copy to /opt/fresh-produce-production/.env. Values here are not app secrets.
# Your existing VPS: Ubuntu 24.04 LTS, 2 vCPU, 8 GB RAM, 100 GB disk.
# Initial staging can use this VPS/hostname before production starts; use a
# separate root, Compose project and Supabase project, and stop staging first.
COMPOSE_PROJECT_NAME=fresh-produce-production
APP_DOMAIN=srv1878510.hstgr.cloud
# Replace with your real certificate contact email.
ACME_EMAIL=ops@example.com
# For repeatable infrastructure, replace with a tested Caddy image digest.
CADDY_IMAGE=caddy:2-alpine
