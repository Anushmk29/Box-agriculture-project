# Copy to /opt/fresh-produce-production/app.env; chmod 600.
# Compose reads this as RAW env: no shell sourcing, quoting or $ expansion.
# Enter literal values without surrounding quotes, including JSON below.
ENVIRONMENT=production
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
SECRET_KEY=REPLACE_WITH_YOUR_EXISTING_PRODUCTION_SECRET_OR_A_NEW_RANDOM_SECRET
PUBLIC_APP_URL=https://srv1878510.hstgr.cloud
CORS_ORIGINS=["https://srv1878510.hstgr.cloud"]
FILE_STORAGE_PROVIDER=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_STORAGE_BUCKET=order-sources
SUPABASE_STORAGE_KEY=REPLACE_WITH_SERVER_ONLY_STORAGE_SECRET
STORAGE_GC_ENABLED=false
# Preserve reviewed rollout settings when moving the existing application.
PACKING_PROFILES_ENABLED=false
EXCEL_TEMPLATE_PROFILES_ENABLED=true
# Optional: supply all three only after accounting approves them.
INVOICE_BANK_NAME=
INVOICE_BANK_ACCOUNT_NAME=
INVOICE_BANK_SWIFT=
