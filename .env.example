# Copy the Session pooler URI from Supabase Dashboard > Connect.
# Percent-encode special characters in the database password.
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
SECRET_KEY=replace-with-a-unique-random-value-of-at-least-32-characters
PUBLIC_APP_URL=https://app.example.com
CORS_ORIGINS=["https://app.example.com"]
# Optional. Set all three only after the client approves the settlement account.
INVOICE_BANK_NAME=
INVOICE_BANK_ACCOUNT_NAME=
INVOICE_BANK_SWIFT=


# Durable intake documents. Required outside development/test; server only.
FILE_STORAGE_PROVIDER=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_STORAGE_BUCKET=order-sources
# Set a server secret key (sb_secret_...) or legacy service-role JWT in your secret manager.
# Never use a publishable/anon key and never expose this as NEXT_PUBLIC_*.
SUPABASE_STORAGE_KEY=
# Point at the approved old upload root during migration; never at an entire filesystem.
# LEGACY_UPLOAD_ROOT=/app/uploads
# Keep cleanup disabled during cutover, restore and until reference inventory is verified.
STORAGE_GC_ENABLED=false

# Allow testing with existing packing fallbacks while product volumes are completed.
PACKING_PROFILES_ENABLED=false
